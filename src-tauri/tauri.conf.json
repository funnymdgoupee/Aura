{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "Aura Assistant",
  "version": "0.1.0",
  "identifier": "com.aura.assistant",
  "build": {
    "beforeDevCommand": "npm run frontend:dev",
    "beforeBuildCommand": "npm run frontend:build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../src-frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Aura Assistant",
        "width": 900,
        "height": 680,
        "minWidth": 720,
        "minHeight": 540,
        "resizable": true,
        "fullscreen": false,
        "hidden": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
